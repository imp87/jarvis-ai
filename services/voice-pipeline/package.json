{
  "name": "@jarvis/voice-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "loopback": "tsx src/cli/loopback.ts",
    "test": "node --test --import tsx ./test/*.test.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@jarvis/shared": "workspace:*",
    "@jarvis/speech": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
