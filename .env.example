# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
ORCHESTRATOR_PORT=8080

# Shared secret every internal service uses to talk to the orchestrator.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=

# Master key for encrypting connector credentials at rest (AES-256-GCM).
# Must be 32 bytes hex (64 chars). Rotating this makes stored credentials unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# ---------------------------------------------------------------------------
# Database (Postgres + pgvector)
# ---------------------------------------------------------------------------
# Host-side ports. Only these are published to the machine; between containers
# the services keep talking on their normal ports (5432, 8080, 8081, 8082, 8090).
# Moved off the defaults so the stack cannot collide with a Postgres or a web
# server already running here.
POSTGRES_HOST_PORT=15432
ORCHESTRATOR_HOST_PORT=18780
TELEGRAM_HOST_PORT=18781
VOICE_PIPELINE_HOST_PORT=18782
ADMIN_HOST_PORT=18783
# Asterisk dials back in through this one, so changing it changes the dialplan.
AUDIOSOCKET_HOST_PORT=18790

# Points at the published port above, for running a service natively against the
# containerised database. Inside Docker, DATABASE_URL is set to the compose
# hostname instead and this value is unused.
DATABASE_URL=postgres://jarvis:jarvis@localhost:15432/jarvis
# Must match the dimension of EMBEDDING_MODEL. Changing this requires a migration.
#   text-embedding-3-small (OpenAI) -> 1536
#   nomic-embed-text (Ollama)       -> 768
#   mxbai-embed-large (Ollama)      -> 1024
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local network only — never expose this through the reverse proxy.
OLLAMA_BASE_URL=http://192.168.1.50:11434

# Which embedding provider to use: openai | ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Notification policy (guards against a false-positive email storm calling you
# at 3am; see docs/architecture.md#notification-policy)
# ---------------------------------------------------------------------------
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
QUIET_HOURS_TIMEZONE=Europe/Berlin
# 0 disables the limit. To stop the agent calling at all, disable the
# voice_call identity or unset OWNER_PHONE_NUMBER — do not set these to 0.
MAX_CALLS_PER_HOUR=0
MAX_CALLS_PER_DAY=8

# ---------------------------------------------------------------------------
# Cost guards — everything that spends money gets a ceiling
# ---------------------------------------------------------------------------
MAX_LLM_CALLS_PER_MINUTE=60
MAX_AGENT_STEPS=12

# Context guards. These bound tokens, which is what providers actually meter —
# a call-per-minute limit does not, and did not stop one 107 KB tool result from
# pushing every request to ~84k input tokens and exhausting the token budget
# mid-phone-call.
#
# Ceiling on a single tool result, in characters (~4 per token). A schema dump or
# directory listing can run to six figures; results are persisted as conversation
# messages, so an unbounded one is replayed on every later turn of that thread.
MAX_TOOL_RESULT_CHARS=8000
# Ceiling on the replayed history. Trimming by message count alone bounds
# nothing — forty messages can be forty kilobytes or forty megabytes.
MAX_HISTORY_CHARS=48000

# ---------------------------------------------------------------------------
# Scheduled tasks (component 11)
#
# Where the orchestrator pushes messages nobody asked for. Compose sets this to
# the adapter's service name; leave it unset to withhold the capability entirely
# rather than offer the agent a way to reach you that goes nowhere.
# ---------------------------------------------------------------------------
# TELEGRAM_ADAPTER_URL=http://telegram-adapter:8081
# How often the scheduler looks for due work. Tasks cannot run faster than once
# a minute regardless — a shorter loop is a busy wait with an API bill attached.
TASK_POLL_INTERVAL_MS=20000

# ---------------------------------------------------------------------------
# MCP servers (component 3)
#
# A stdio MCP server runs as a child of the orchestrator, so its paths are
# whatever the orchestrator can see — a host path when run natively, a container
# path under Docker. Registry rows therefore store ${MCP_WORKSPACE_DIR} instead
# of a literal path, and each environment supplies the value. Compose sets it to
# /workspace and mounts MCP_WORKSPACE_HOST_DIR there.
# ---------------------------------------------------------------------------
MCP_WORKSPACE_DIR=./.local/workspace
# MCP_WORKSPACE_HOST_DIR=/srv/jarvis/workspace

# ---------------------------------------------------------------------------
# Web access (embedded "web" MCP server)
#
# Gives the agent mcp_web__search and mcp_web__read — where every current answer
# comes from: weather, news, prices, opening hours. Both refuse anything that
# resolves into the private network, because the model picks those URLs out of
# search results and page text that strangers write.
#
#   duckduckgo  no account, no key, works out of the box. It scrapes the HTML
#               endpoint, so switch providers if results ever dry up.
#   brave       BRAVE_SEARCH_API_KEY; a proper API with a free tier.
#   searxng     SEARXNG_URL of your own instance. That one URL is exempt from
#               the private-network guard, since it is normally on the LAN.
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=http://searxng:8080
# Per-request timeout, and the ceiling on a downloaded page before text
# extraction — a search hit can point at a gigabyte just as easily as an article.
WEB_REQUEST_TIMEOUT_MS=15000
WEB_FETCH_MAX_BYTES=2000000

# ---------------------------------------------------------------------------
# Admin UI (component 8)
#
# The UI holds SERVICE_TOKEN server-side and never ships it to the browser, so
# this password is the only credential you type — it decides whether the server
# acts on your behalf, nothing more. The session cookie is signed with a key
# derived from it, which means changing the password logs every session out.
# ---------------------------------------------------------------------------
# At least 12 characters. Generate: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=
# How long a login lasts before it has to be repeated.
ADMIN_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Telegram adapter (component 9)
# ---------------------------------------------------------------------------
TELEGRAM_ADAPTER_PORT=8081
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# polling | webhook — both are supported deployments.
#
# polling needs NO inbound reachability: no DynDNS, no port forward, no
# certificate. This is the current setup, because Telegram delivers webhooks
# only to ports 80, 88, 443 and 8443, and a DS-Lite connection with an ISP port
# range outside those cannot receive one. Latency is not a real cost: the long
# poll returns the moment a message arrives.
TELEGRAM_MODE=polling

# Only for webhook mode. The port must be 80, 88, 443 or 8443 — anything else is
# rejected by Telegram, and the adapter refuses to start rather than let you find
# out at runtime.
# TELEGRAM_WEBHOOK_URL=https://jarvis.example.de
# Keep the path long and random; it is a weak secret but it keeps scanners out of the logs.
TELEGRAM_WEBHOOK_PATH=/telegram/webhook-CHANGEME-random
# Echoed by Telegram on every delivery. A-Z a-z 0-9 _ - only, 32+ chars.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Drop deliveries from outside Telegram's published ranges. Set false only if a
# proxy in front already restricts source IPs (or if you get IPv6 deliveries).
TELEGRAM_IP_ALLOWLIST=true
MAX_VOICE_BYTES=20971520

ORCHESTRATOR_URL=http://127.0.0.1:18780

# ---------------------------------------------------------------------------
# Speech (packages/speech) — shared by Telegram, the future voice-call pipeline
# and any wake-word client
#
# Default is local: voice notes are sensitive and do not leave the machine
# unless that is a deliberate choice.
# ---------------------------------------------------------------------------
STT_ENGINE=local
TTS_ENGINE=local

# Phone calls default to the proven per-turn pipeline. Set "realtime" to use
# continuous bidirectional OpenAI audio while retaining the Jarvis tool bridge.
VOICE_MODE=turn

# Optional: higher-accuracy OpenAI STT and a German technical vocabulary hint.
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_STT_PROMPT=Deutsch (de-DE), persönlicher Assistent. Begriffe: Jarvis, Supabase, MCP, PostgreSQL, Docker, VPS. Transkribiere wörtlich.
# 1.0 is OpenAI's default. 1.15 is a natural, slightly faster phone pace.
OPENAI_TTS_SPEED=1.15
# Used only when VOICE_MODE=realtime.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Cedar is a deeper, masculine-presenting voice suited to the Jarvis persona.
OPENAI_REALTIME_VOICE=cedar

# Local STT: runs in-process via transformers.js, no system install needed.
# Measured on a desktop CPU: ~1.3s to load, then ~1s per 5s of audio.
# whisper-small is noticeably better on German and roughly 3x slower.
WHISPER_MODEL=Xenova/whisper-base
# WHISPER_CACHE_DIR=/var/lib/jarvis/models

# Local TTS: Piper needs a binary and a voice model — see docs/telegram-setup.md.
# de_DE-thorsten-medium runs at 22050 Hz.
PIPER_BINARY=/opt/piper/piper
PIPER_MODEL=/opt/piper/de_DE-thorsten-medium.onnx
PIPER_SAMPLE_RATE=22050
# Optional: directory of extra .onnx voices, so a per-user voiceId can select one.
# PIPER_VOICES_DIR=/opt/piper/voices

# ---------------------------------------------------------------------------
# Voice pipeline (component 1) — registers at the FritzBox as an IP telephone
# (Telefonie -> Telefoniegeraete -> Neues Geraet -> LAN/WLAN-Telefon).
# One registration serves both directions: place and receive calls.
# ---------------------------------------------------------------------------
VOICE_PIPELINE_PORT=8082
SIP_ADRESS=fritz.box
SIP_USER=
SIP_PASSWORD=
# Which of the FritzBox numbers outgoing calls present, if it serves several.
# SIP_CALLER_ID=
VOICE_GREETING=Master, Jarvis hier. Womit kann ich dienen?
VOICE_IDLE_HANGUP_MS=30000

# Who the agent may call, and — via a voice_call identity — who may call it.
OWNER_PHONE_NUMBER=+4915561049738
